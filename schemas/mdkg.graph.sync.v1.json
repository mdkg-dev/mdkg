{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.graph.sync.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.graph.sync.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/SyncData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "SyncData": {
      "description": "`graph sync`.",
      "type": "object",
      "properties": {
        "remote": {
          "type": "string"
        },
        "remote_ref": {
          "type": "string"
        },
        "approved": {
          "description": "The destination is approved and unchanged: pushes may go there.",
          "type": "boolean"
        },
        "before": {
          "description": "The local graph tip before and after.",
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "remote_tip": {
          "description": "The remote's graph tip after the sync (`null`: it has none).",
          "type": [
            "string",
            "null"
          ]
        },
        "pushed": {
          "type": "boolean"
        },
        "ahead": {
          "description": "The local graph holds commits the remote doesn't.",
          "type": "boolean"
        },
        "conflicts": {
          "description": "Paths a merge took the remote's version of (G12).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConflictRecord"
          }
        }
      },
      "required": [
        "remote",
        "remote_ref",
        "approved",
        "before",
        "after",
        "remote_tip",
        "pushed",
        "ahead",
        "conflicts"
      ]
    },
    "ConflictRecord": {
      "description": "The graph sync record of one conflict.",
      "type": "object",
      "properties": {
        "merge": {
          "description": "The sync merge commit that took the remote's version.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "local": {
          "description": "The local version's blob (`null`: the local side deleted it).",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "description": "The remote version's blob (`null`: the remote deleted it).",
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "description": "When it was recorded, in Unix seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "merge",
        "path",
        "local",
        "remote",
        "time"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/SeverityName"
        },
        "path": {
          "description": "Relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "node": {
          "description": "The node's id (`ws:id` outside the root workspace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "The actors it's about (a lease's holders): names other actors\nchose, so data, never part of the message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationOut"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
