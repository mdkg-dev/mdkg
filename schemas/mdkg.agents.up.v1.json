{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.agents.up.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.agents.up.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpEvent"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "UpEvent": {
      "description": "One event of `agents up`, as its JSON lines carry it.",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "event": {
          "description": "`turn`, `wake`, `paused`, `manual`, `trouble` or `stopped` (drained\nby `agents stop`).",
          "type": "string"
        },
        "turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "wake": {
          "anyOf": [
            {
              "$ref": "#/$defs/Report"
            },
            {
              "type": "null"
            }
          ]
        },
        "paused": {
          "description": "Threads the loop guard paused, with mail waiting.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cooldown_secs": {
          "description": "Seconds until the soonest paused thread runs again.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "agent",
        "event"
      ]
    },
    "TurnReport": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "turn": {
          "description": "The turn's number for this agent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "shown": {
          "description": "The messages shown to the agent (and acked, when it replied).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved_decisions": {
          "description": "Revalidated decisions actually promoted into this turn prompt.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropped_decisions": {
          "description": "Valid decisions left untrusted because the trusted section had no\nroom; ask their delegate to send them again.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reply_id": {
          "description": "The imported reply's message id.",
          "type": [
            "string",
            "null"
          ]
        },
        "reply": {
          "description": "A task-only turn's final message, which wasn't imported.",
          "type": [
            "string",
            "null"
          ]
        },
        "receipt": {
          "description": "Launcher receipt delivery is advisory and never changes the turn outcome.",
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "description": "`--dry-run`: what would run, and its prompt.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "logs": {
          "description": "Where the turn's files are, when they were kept.",
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "description": "Historical launcher-commit field, omitted by current turns. Workers commit themselves.",
          "type": [
            "string",
            "null"
          ]
        },
        "commit_refused": {
          "description": "Historical launcher-commit refusal, omitted by current turns.",
          "type": [
            "string",
            "null"
          ]
        },
        "commit_refused_code": {
          "description": "Historical launcher-commit refusal code, omitted by current turns.",
          "type": [
            "string",
            "null"
          ]
        },
        "commit_note": {
          "description": "Historical launcher-commit note, omitted by current turns.",
          "type": [
            "string",
            "null"
          ]
        },
        "commit_note_failed": {
          "description": "Historical launcher-commit note error, omitted by current turns.",
          "type": [
            "string",
            "null"
          ]
        },
        "launcher_notes": {
          "description": "Launcher notes in the agent's mail (from the launcher's own actor),\nacked unseen and dropped: their message ids.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_answered": {
          "description": "Mail no reply could reach (the agent's own post, a sender whose\nname holds a comma), acked as not answered: their message ids.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thread": {
          "description": "The thread this turn answered ([`thread_key`]).",
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "description": "What the turn used, as its harness reported it (cost, tokens).",
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "paused": {
          "description": "Threads with unacked mail this turn left alone: the loop guard\npaused them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropped_allow": {
          "description": "The agent's allow rules that are never passed to its harness (fail\nclosed): one that can't be read (an unbalanced quote, a stray\nescape, a list of rules), or one that lets mdkg run with open\narguments (`Bash(mdkg *)`, `Bash(*)`), each with what to allow\ninstead (`Bash(mdkg validate *)`, or the mdkg MCP server).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DroppedAllow"
          }
        },
        "codex_hook_trust": {
          "description": "Per-attempt hook trust decisions, including authentication retries.\nEmpty for idle turns, reviewers and other harnesses.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodexHookTrustReceipt"
          }
        }
      },
      "required": [
        "agent",
        "harness",
        "role",
        "outcome",
        "shown"
      ]
    },
    "Harness": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "Role": {
      "type": "string",
      "enum": [
        "worker",
        "reviewer"
      ]
    },
    "Outcome": {
      "oneOf": [
        {
          "description": "No mail and no task: nothing ran.",
          "type": "string",
          "const": "idle"
        },
        {
          "description": "The agent answered its mail and the reply was imported (`reply_id`).",
          "type": "string",
          "const": "replied"
        },
        {
          "description": "The agent answered its mail with exactly [`crate::digest::NO_REPLY`],\nor had already answered the newest message during the turn (a\nhandoff or findings to its sender in reply or in its context; its\nfinal message isn't imported as a second reply, #20931):\nthe launcher sent no final reply and acked as answered the shown mail\nstill held and still unacked (the agent's own earlier acks keep their\noutcome; a role lost during the turn leaves its mail unacked), and\nthere's no `reply` and no `reply_id`. A launcher receipt may\nstill go to `reports_to`.",
          "type": "string",
          "const": "no_reply"
        },
        {
          "description": "A task-only turn ran; with no message to reply to, nothing was\nimported and the reply is in the report.",
          "type": "string",
          "const": "ran"
        },
        {
          "description": "`--dry-run`: the command and prompt, unrun.",
          "type": "string",
          "const": "dry_run"
        }
      ]
    },
    "DeliveryStatus": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "path": {
          "description": "Immutable local receipt, retained even when mail delivery is refused.",
          "type": [
            "string",
            "null"
          ]
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Non-fatal receipt failure; never means the agent should run again.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "turn_id",
        "path",
        "message_id",
        "error"
      ]
    },
    "AgentCommand": {
      "description": "A process to start for one turn. It runs with [`Self::environment`]\n(by default the allowlist, [`crate::env`]) plus `env`.",
      "type": "object",
      "properties": {
        "program": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "description": "Variables set on top of the environment the turn inherits.",
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "prompt_on_stdin": {
          "description": "Whether the prompt goes on stdin (otherwise it's in `args`).",
          "type": "boolean"
        },
        "output_file": {
          "description": "Codex writes its final message here (`-o`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "program",
        "args",
        "cwd",
        "env",
        "prompt_on_stdin"
      ]
    },
    "Usage": {
      "description": "A turn's cost and tokens as its harness prints them: Claude's result\nevent, Codex's `tokens used` line, OpenCode's step events. Each field is\nwhat that harness says, or absent; nothing is estimated.",
      "type": "object",
      "properties": {
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "DroppedAllow": {
      "description": "An allow rule that's never passed to the harness, and what to write\ninstead.",
      "type": "object",
      "properties": {
        "rule": {
          "description": "The rule, as configured.",
          "type": "string"
        },
        "fix": {
          "description": "Why it's dropped, and what to allow instead.",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "fix"
      ]
    },
    "CodexHookTrustReceipt": {
      "description": "A fixed explanation of the decision made at a Codex worker spawn boundary.\nDry-run entries are previews; every actual attempt records its decision.",
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "decision": {
          "$ref": "#/$defs/CodexHookTrust"
        },
        "reason": {
          "type": "string"
        },
        "preview": {
          "type": "boolean"
        }
      },
      "required": [
        "attempt",
        "decision",
        "reason",
        "preview"
      ]
    },
    "CodexHookTrust": {
      "description": "The hook-trust decision for one actual Codex worker launch attempt.\nA turn with an authentication retry may have a different second decision.",
      "oneOf": [
        {
          "description": "Historical receipt variant. New launches do not emit this until a\ncomplete invocation-wide hook-source inventory is qualified.",
          "type": "string",
          "const": "bypassed"
        },
        {
          "description": "All active hook sources could not be verified; ordinary trust applies.",
          "type": "string",
          "const": "required"
        }
      ]
    },
    "Report": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/WakeStatus"
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "through": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "session",
        "through"
      ]
    },
    "WakeStatus": {
      "type": "string",
      "enum": [
        "waiting",
        "busy",
        "suspended",
        "paused",
        "no_mail",
        "queued",
        "not_sent",
        "delivery_unknown",
        "mode_changed"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/SeverityName"
        },
        "path": {
          "description": "Relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "node": {
          "description": "The node's id (`ws:id` outside the root workspace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "The actors it's about (a lease's holders): names other actors\nchose, so data, never part of the message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationOut"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
