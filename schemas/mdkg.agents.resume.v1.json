{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.agents.resume.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.agents.resume.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResumeData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "ResumeData": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "resumed": {
          "description": "The threads let run again.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiting_for_prompt": {
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "resumed",
        "waiting_for_prompt"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/SeverityName"
        },
        "path": {
          "description": "Relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "node": {
          "description": "The node's id (`ws:id` outside the root workspace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "The actors it's about (a lease's holders): names other actors\nchose, so data, never part of the message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationOut"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
    "Code": {
      "description": "A stable diagnostic code.",
      "type": "string",
      "enum": [
        "usage.invalid_arguments",
        "usage.empty_query",
        "usage.bad_limit",
        "usage.unsupported_type",
        "usage.unknown_field",
        "usage.unknown_status",
        "usage.unknown_type",
        "usage.unknown_changeset",
        "usage.bad_status",
        "usage.bad_value",
        "usage.path_outside_worktree",
        "config.missing",
        "config.unreadable",
        "config.invalid",
        "config.unknown_workspace",
        "config.graph_v2_unsupported",
        "frontmatter.missing_open",
        "frontmatter.unclosed",
        "frontmatter.blank_line",
        "frontmatter.not_key_value",
        "frontmatter.stray_cr",
        "frontmatter.invalid_key",
        "frontmatter.duplicate_key",
        "frontmatter.empty_value",
        "frontmatter.bad_list",
        "frontmatter.empty_list_item",
        "frontmatter.too_large",
        "node.unknown_type",
        "node.bad_id",
        "node.unknown_key",
        "node.wrong_kind",
        "node.empty_field",
        "node.not_lowercase",
        "node.bad_date",
        "node.missing_status",
        "node.bad_status",
        "node.status_not_allowed",
        "node.bad_priority",
        "node.priority_not_allowed",
        "node.bad_ref",
        "node.bad_skill_slug",
        "node.skills_not_allowed",
        "node.bad_scope",
        "node.supersedes_not_allowed",
        "node.bad_supersedes",
        "node.bad_identity",
        "node.identity_unsupported",
        "node.bad_integer",
        "node.duplicate_id",
        "node.bad_legacy_id",
        "node.duplicate_legacy_id",
        "node.extension_key_conflict",
        "node.stale_type",
        "node.date_only",
        "node.legacy_extension_key",
        "node.bad_body_link",
        "node.not_found",
        "node.ambiguous",
        "node.resolved",
        "node.exists",
        "node.none_ready",
        "node.not_work",
        "node.heading_missing",
        "node.raw_prompt",
        "node.raw_payload",
        "node.raw_secret",
        "node.legacy_spec_file",
        "node.legacy_spec_type",
        "goal.bad_state",
        "goal.condition_too_long",
        "goal.bad_scope_ref",
        "goal.empty_check",
        "goal.scope_ref_missing",
        "goal.scope_ref_wrong_type",
        "goal.active_node_missing",
        "goal.active_node_wrong_type",
        "goal.active_node_outside_scope",
        "goal.multiple_active",
        "goal.none_active",
        "goal.not_goal",
        "edge.missing_target",
        "edge.prev_next_asymmetric",
        "edge.cycle",
        "template.missing",
        "template.invalid",
        "template.fallback",
        "skill.both_files",
        "skill.missing_file",
        "skill.legacy_file",
        "skill.missing_slug",
        "skill.mirror_missing",
        "skill.mirror_manifest_missing",
        "index.limit_exceeded",
        "io.read_failed",
        "io.git_failed",
        "io.write_failed",
        "coord.lease_held",
        "coord.cas_failed",
        "coord.past_deadline",
        "coord.not_owner",
        "coord.not_active",
        "coord.no_lease",
        "coord.unknown_lease",
        "coord.unknown_changeset",
        "coord.already_settled",
        "coord.out_of_scope",
        "coord.observation_raced",
        "coord.key_reused",
        "coord.duplicate_lease",
        "coord.sync_needed",
        "coord.sync_failed",
        "coord.path_missing",
        "coord.lease_limit",
        "coord.lease_shared",
        "coord.node_done",
        "coord.contains_abandoned",
        "coord.store_failed",
        "coord.store_restored",
        "coord.store_upgraded",
        "coord.authority_failed",
        "coord.authority_remote",
        "coord.authority_note",
        "coord.authority_ignored",
        "log.broken",
        "log.anchor_mismatch",
        "log.anchor_missing",
        "log.anchored",
        "edge.target_not_on_branch",
        "edge.private_target",
        "edge.blocks_ancestor",
        "msg.human_actor",
        "msg.reserved_actor",
        "msg.bad_kind",
        "msg.bad_id",
        "msg.no_parts",
        "msg.too_large",
        "msg.secret_refused",
        "msg.id_reused",
        "msg.no_recipients",
        "msg.unknown_message",
        "msg.unknown_context",
        "msg.not_holder",
        "msg.not_shown",
        "msg.wait_timeout",
        "room.unknown",
        "room.exists",
        "room.not_member",
        "room.human_member",
        "mcp.call_timeout",
        "mcp.cli_failed",
        "run.unknown_agent",
        "run.agent_failed",
        "run.sandbox_mismatch",
        "run.no_reply",
        "run.mail_failed",
        "run.io_failed",
        "run.unsupported",
        "run.branch_refused",
        "run.too_many_failures",
        "run.cwd_outside",
        "install.unmergeable",
        "install.unsupported_layout",
        "init.exists",
        "doctor.check_failed",
        "doctor.check_warned",
        "skill.not_found",
        "skill.invalid",
        "skill.mirror_drift",
        "skill.mirror_stale",
        "skill.mirror_targets_unsupported",
        "skill.exists",
        "init.needs_migrate",
        "init.conflict",
        "init.unexplained",
        "usage.deprecated",
        "migrate.plan_mismatch",
        "migrate.dirty",
        "migrate.in_progress",
        "migrate.not_migrated",
        "migrate.moved_on",
        "migrate.store_changed",
        "migrate.unsupported",
        "migrate.already_migrated",
        "migrate.step_failed"
      ]
    },
    "SeverityName": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "LocationOut": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "path"
      ]
    }
  }
}
