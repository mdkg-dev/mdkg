{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.agents.status.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.agents.status.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "StatusData": {
      "type": "object",
      "properties": {
        "event_cursor": {
          "description": "The event stream's head, read with this snapshot: `msg watch\n--after` it to see every change since (A10). Absent without a store.",
          "type": [
            "string",
            "null"
          ]
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentStatus"
          }
        },
        "config_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threads": {
          "description": "The central record of agent threads, every harness's, newest first:\ninteractive sessions their hooks keep (working while in a turn, idle\nafter it), and threads `agents attach` keeps while it runs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Thread"
          }
        },
        "receivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReceiverStatus"
          }
        },
        "processes": {
          "description": "Registered launcher and MCP processes whose build-record locks are held.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Process"
          }
        },
        "build_warnings": {
          "description": "Mixed builds, changed executables, or unreadable process build records.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progress": {
          "description": "Durable watches, including interrupted actors without runtime state.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgressStatus"
          }
        }
      },
      "required": [
        "agents",
        "config_warnings",
        "threads",
        "receivers",
        "processes",
        "build_warnings",
        "progress"
      ]
    },
    "AgentStatus": {
      "description": "One agent in `agents status`.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "effective": {
          "description": "Layered file definition for the next preparation; saved state fields\nbelow continue to describe the last prepared agent.",
          "anyOf": [
            {
              "$ref": "#/$defs/EffectiveAgentData"
            },
            {
              "type": "null"
            }
          ]
        },
        "configured": {
          "description": "Named in the config's `agents`.",
          "type": "boolean"
        },
        "known": {
          "description": "Has saved machine-local runtime state.",
          "type": "boolean"
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Harness"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "turns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "paused": {
          "description": "Threads the loop guard pauses now.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "problem": {
          "description": "Why this agent's config or policy can't run, if it can't.",
          "type": [
            "string",
            "null"
          ]
        },
        "receipt": {
          "description": "Latest advisory receipt; delivery failure never makes this agent unrunnable.",
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_problem": {
          "description": "Why the local receipt status could not be read, distinct from no receipt yet.",
          "type": [
            "string",
            "null"
          ]
        },
        "dropped_allow": {
          "description": "Its allow rules that are never passed to its harness: unreadable,\nor letting mdkg run with open arguments, each with what to allow\ninstead. Read against this binary; a turn reads them against the\n`--binary` it runs, and its report names any it drops.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DroppedAllow"
          }
        },
        "auth": {
          "description": "The account its turns would bill now, from its harness's own login\ncheck and the Keychain's list (no key is read).",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "billing": {
          "description": "The key, offered or marked: after a usage limit, the `agents use-key`\ncommand to bill the next turn on it; a mark waiting for that turn;\nor a mark held because it couldn't be recorded durably.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "What a client needs to re-attach (API v1 A18): `stopped`, `idle`,\n`running`, `draining` or `paused` (an open set).",
          "type": "string"
        },
        "supervisor": {
          "description": "The supervisor running it, or the last one whose record names it\nwhen that one is gone (`stale`); null when none.",
          "anyOf": [
            {
              "$ref": "#/$defs/SupervisorView"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_turn": {
          "description": "The turn running now; null when none.",
          "anyOf": [
            {
              "$ref": "#/$defs/CurrentTurn"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_turn": {
          "description": "The last turn that isn't running; null when none.",
          "anyOf": [
            {
              "$ref": "#/$defs/LastTurn"
            },
            {
              "type": "null"
            }
          ]
        },
        "follow_from": {
          "description": "The position `agents logs <agent> --follow --after` takes to pick up\nfrom this snapshot: never \"from now\", so a turn that starts or ends\nin between is still delivered.",
          "type": "string"
        },
        "code_base": {
          "description": "A worker's branch against mainRef (ref mode, G15): absent when\nthere's no mainRef here, or no worktree yet.",
          "anyOf": [
            {
              "$ref": "#/$defs/CodeBase"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "configured",
        "known",
        "turns",
        "policy",
        "state",
        "supervisor",
        "current_turn",
        "last_turn",
        "follow_from"
      ]
    },
    "EffectiveAgentData": {
      "description": "Source-attributed settings used for a file-backed agent's next preparation.",
      "type": "object",
      "properties": {
        "values": true,
        "origins": {
          "description": "Full config JSON pointers, matching `config show --effective`.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/OriginData"
          }
        },
        "redacted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "values",
        "origins",
        "redacted"
      ]
    },
    "OriginData": {
      "type": "object",
      "properties": {
        "layer": {
          "$ref": "#/$defs/SourceLayer"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "layer"
      ]
    },
    "SourceLayer": {
      "type": "string",
      "enum": [
        "built_in",
        "user",
        "project",
        "local",
        "flags"
      ]
    },
    "Harness": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "Role": {
      "type": "string",
      "enum": [
        "worker",
        "reviewer"
      ]
    },
    "Policy": {
      "description": "An agent's policy, every field resolved.",
      "type": "object",
      "properties": {
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "loop_guard": {
          "description": "`None` is off.",
          "anyOf": [
            {
              "$ref": "#/$defs/LoopGuard"
            },
            {
              "type": "null"
            }
          ]
        },
        "concurrency": {
          "description": "The most turns this supervisor runs at once; `None` is no cap.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "timeout": {
          "description": "How long one turn may run; `None` is no limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retry": {
          "$ref": "#/$defs/Retry"
        },
        "budget": {
          "description": "Planned: tokens or cost. 0.7.0 has none, so any value is a later\nkind.",
          "anyOf": [
            {
              "$ref": "#/$defs/Later"
            },
            {
              "type": "null"
            }
          ]
        },
        "auth": {
          "description": "Which account turns bill ([`crate::auth`]).",
          "$ref": "#/$defs/Auth"
        },
        "later": {
          "description": "Later kinds of `loop_guard`, `concurrency` and `timeout`, whose\n0.7.0 values have no room for one: kept here, so `agents status`\nshows them and an agent's own value can replace a default's.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Later"
          }
        }
      },
      "required": [
        "trigger",
        "shape",
        "session",
        "loop_guard",
        "concurrency",
        "timeout",
        "retry",
        "budget",
        "auth"
      ]
    },
    "Trigger": {
      "oneOf": [
        {
          "description": "Mail to the agent or its rooms wakes it.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mail"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Run explicitly with `mdkg agents up <name> --once`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "later"
            }
          },
          "$ref": "#/$defs/Later",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Later": {
      "description": "A kind a later release adds, read now so the config doesn't break.",
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "later_kind": {
          "description": "The kind as written (`schedule`); the field's own `kind` says\n`later`.",
          "type": "string"
        },
        "settings": {
          "description": "Its settings, as written."
        }
      },
      "required": [
        "field",
        "later_kind",
        "settings"
      ]
    },
    "Shape": {
      "oneOf": [
        {
          "description": "One run shows the agent's unacked mail (one conversation, up to\n`max` messages) and replies once; mail left over wakes the next.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "batch"
            },
            "max": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "max"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "later"
            }
          },
          "$ref": "#/$defs/Later",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Session": {
      "oneOf": [
        {
          "description": "Each turn resumes the agent's session.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resume"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "later"
            }
          },
          "$ref": "#/$defs/Later",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "LoopGuard": {
      "description": "At most `turns` automatic turns per thread in any `window`.",
      "type": "object",
      "properties": {
        "turns": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "turns",
        "window"
      ]
    },
    "Retry": {
      "oneOf": [
        {
          "description": "A failed turn leaves its mail unacked; the next trigger retries.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "later"
            }
          },
          "$ref": "#/$defs/Later",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Auth": {
      "description": "Which account an agent's turns bill: its harness's subscription login,\nand an API key from the Keychain only for a turn `mdkg agents use-key`\nmarks, which `api_key_fallback` permits.",
      "type": "object",
      "properties": {
        "prefer": {
          "description": "Always `subscription` in 0.7.0.",
          "$ref": "#/$defs/Prefer"
        },
        "api_key_fallback": {
          "description": "Permits `mdkg agents use-key`, which bills one turn on the key. It\nnever uses the key automatically: not for a harness that isn't\nlogged in, and not after a usage limit (decided 2026-10-29).",
          "type": "boolean"
        }
      },
      "required": [
        "prefer",
        "api_key_fallback"
      ]
    },
    "Prefer": {
      "type": "string",
      "enum": [
        "subscription"
      ]
    },
    "DeliveryStatus": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "path": {
          "description": "Immutable local receipt, retained even when mail delivery is refused.",
          "type": [
            "string",
            "null"
          ]
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Non-fatal receipt failure; never means the agent should run again.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "turn_id",
        "path",
        "message_id",
        "error"
      ]
    },
    "DroppedAllow": {
      "description": "An allow rule that's never passed to the harness, and what to write\ninstead.",
      "type": "object",
      "properties": {
        "rule": {
          "description": "The rule, as configured.",
          "type": "string"
        },
        "fix": {
          "description": "Why it's dropped, and what to allow instead.",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "fix"
      ]
    },
    "AuthStatus": {
      "description": "The account a harness would bill now, for `agents status` and `doctor`,\nwithout reading any key.",
      "type": "object",
      "properties": {
        "source": {
          "description": "`subscription`, `own_config` (OpenCode) or `none`; never `api_key`\n(0.7.0's fallback), since the key bills only a turn use-key marks.",
          "type": "string"
        },
        "method": {
          "description": "The login method the harness reports, when logged in.",
          "type": [
            "string",
            "null"
          ]
        },
        "api_key_fallback": {
          "type": "boolean"
        },
        "key_in_keychain": {
          "description": "Whether the Keychain holds the fallback's key.",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "api_key_fallback",
        "key_in_keychain"
      ]
    },
    "SupervisorView": {
      "description": "The supervisor running the agent, or the last one whose record names\nit when that one is gone (`stale`).",
      "type": "object",
      "properties": {
        "supervisor_id": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "started_at": {
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "description": "`running` or `stale` (its record is there, its process is gone).",
          "type": "string"
        }
      },
      "required": [
        "supervisor_id",
        "pid",
        "started_at",
        "build",
        "state"
      ]
    },
    "Build": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "built": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "dirty",
        "built"
      ]
    },
    "CurrentTurn": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "started_at": {
          "type": "string"
        },
        "output_after": {
          "description": "The latest `seq` in its output journal.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "turn_id",
        "number",
        "started_at",
        "output_after"
      ]
    },
    "LastTurn": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outcome": {
          "description": "`replied`, `ran`, `idle`, `dry_run`, `failed`, `interrupted` or\n`not_started`; an open set.",
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "turn_id",
        "number",
        "outcome",
        "ended_at"
      ]
    },
    "CodeBase": {
      "description": "How a worker's branch stands against the code base it follows.",
      "type": "object",
      "properties": {
        "main_ref": {
          "description": "mainRef's full name.",
          "type": "string"
        },
        "ahead": {
          "description": "Commits on the worker's branch that mainRef lacks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "behind": {
          "description": "Commits on mainRef that the worker's branch lacks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "main_ref",
        "ahead",
        "behind"
      ]
    },
    "Thread": {
      "description": "One agent thread (a session of any harness) in the central record of\nagent threads. All harnesses share this record, with two kinds:\n- hook-observed: no owner. A session's start and stop hooks keep it,\n  short-lived processes with nothing to own it.\n- attach-owned: `owner` is the attach's process, which binds the session\n  to its actor while it runs and removes the record when it ends.\n\n`agents status` lists both.",
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "harness": {
          "description": "claude, codex or opencode.",
          "type": "string"
        },
        "session": {
          "description": "The harness's session or thread id.",
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ThreadState"
        },
        "first_seen_ms": {
          "description": "Earliest known observation, in milliseconds since the epoch. Old\nrecords default to zero; their next write uses the old last-seen time.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "last_seen_ms": {
          "description": "Latest observation or attach update, in milliseconds since the epoch.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "last_state_change_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "last_observation": {
          "description": "The latest hook, kept independently of attach updates.",
          "anyOf": [
            {
              "$ref": "#/$defs/HookObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_session_start": {
          "description": "Retained across prompt/stop hooks so attach cannot miss a SessionStart\nmerely because another hook followed it before the next poll.",
          "anyOf": [
            {
              "$ref": "#/$defs/HookObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "description": "The attach owning it; `None` for a hook-observed thread.",
          "anyOf": [
            {
              "$ref": "#/$defs/Owner"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor",
        "harness",
        "session",
        "cwd",
        "state",
        "first_seen_ms",
        "last_seen_ms",
        "last_state_change_ms"
      ]
    },
    "ThreadState": {
      "description": "Whether an agent thread is in a turn or waiting for one.",
      "type": "string",
      "enum": [
        "working",
        "idle"
      ]
    },
    "HookObservation": {
      "description": "One hook observation, with its own time. A later attach update must not\nmake an old hook observation look new.",
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/HookEvent"
        },
        "harness_event": {
          "description": "Unknown or absent harness events stay absent; never infer SessionStart.",
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessEvent"
            },
