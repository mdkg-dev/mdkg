      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "started": {
          "description": "The process's start time as `ps` prints it.",
          "type": "string"
        },
        "generation": {
          "description": "Chosen by the attach, new for each run.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "host",
        "pid",
        "started",
        "generation"
