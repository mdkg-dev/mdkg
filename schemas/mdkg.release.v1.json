{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.release.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.release.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "x-mdkg-lease-authority": 1,
  "$defs": {
    "ReleaseOutput": {
      "description": "The shapes `release` prints: one lease, or what `--all` did with each\nof the actor's leases.",
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseData"
        },
        {
          "$ref": "#/$defs/ReleaseManyData"
        }
      ]
    },
    "ReleaseData": {
      "type": "object",
      "properties": {
        "lease": {
          "$ref": "#/$defs/LeaseRecord"
        },
        "releases": {
          "description": "With several targets: each one's lease, in the order given (`lease`\nabove is the first's). Absent for one target.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReleasedTarget"
          }
        }
      },
      "required": [
        "lease"
      ]
    },
    "LeaseRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "node": {
          "description": "For a profile C scope (`node:<uuid>`): the node it is.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeName"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "until": {
          "description": "When the lease ends, RFC 3339 UTC.",
          "type": "string"
        },
        "deadline_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "description": "`exclusive`, or `shared` when the config lets others share the path.",
          "type": "string"
        },
        "shared_with": {
          "description": "Owners of other active leases overlapping a shared one, or one\nheld on a branch (theirs on other branches).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branch": {
          "description": "The branch a path lease holds its scope on, where the repository\nscopes path leases by branch; absent for one held on every branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "changeset": {
          "type": [
            "string",
            "null"
          ]
        },
        "mine": {
          "description": "In `status`: whether the lease is the acting actor's.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "expiring": {
          "description": "In `status`: true when an active lease is in the last eighth of its\ntime (15 minutes of the default 2 hours); `mdkg renew` extends\nit.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "idle": {
          "description": "In `status`: true for a path lease with no changes in its owner's\nworktree, past the first quarter of its term, while no\nturn of the owner's (`run:<owner>`) runs. `mdkg renew` won't keep\nit, and its owner can give it up with `mdkg release <path>`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "age_ms": {
          "description": "In `status` and `holds`, for an active lease: milliseconds since it\nwas last claimed, claimed again or renewed (read from its deadline\nand the store's term).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "clean": {
          "description": "In `status` and `holds`, for an active path lease: true when its\npaths have no changes, staged or not, in its owner's worktree. Absent\nwhen git can't say or the owner's worktree isn't found.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "committed": {
          "description": "In `status` and `holds`, beside `clean`: true when the owner has\ncommitted the lease's paths since it was granted, nothing in them\nis uncommitted, and the owner works in that worktree. Its owner's\n`mdkg release --committed` releases such a lease; nothing releases\nit by itself.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "merge_conflicts": {
          "description": "In `status`, for your shared path leases: each co-holder whose\nbranch head conflicts with yours (by `git merge-tree`, committed\ncontent only) in files under the lease. Advisory: nothing is\nrefused, and the merge settles it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MergeConflict"
          }
        }
      },
      "required": [
        "id",
        "owner",
        "scope",
        "status",
        "until",
        "deadline_ms",
        "mode"
      ]
    },
    "NodeName": {
      "description": "The node a profile C scope (`node:<uuid>`) names, so a reader never\nsees a bare UUID alone.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Its current full id.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "MergeConflict": {
      "description": "A co-holder's branch that conflicts with yours under a shared lease.",
      "type": "object",
      "properties": {
        "owner": {
          "description": "The co-holder.",
          "type": "string"
        },
        "paths": {
          "description": "The conflicting files under the lease, relative to the top.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "owner",
        "paths"
      ]
    },
    "ReleasedTarget": {
      "description": "One target's lease in a `release` of several.",
      "type": "object",
      "properties": {
        "target": {
          "description": "The target as given.",
          "type": "string"
        },
        "lease": {
          "description": "The lease, released by this call or already ended before it.",
          "$ref": "#/$defs/LeaseRecord"
        }
      },
      "required": [
        "target",
        "lease"
      ]
    },
    "ReleaseManyData": {
      "type": "object",
      "properties": {
        "released": {
          "description": "Leases this run released, each in its own transaction.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeaseRecord"
          }
        },
        "skipped": {
          "description": "Leases left as they are, each with the reason: `--committed` lists\neach path lease of yours it kept (`uncommitted`, `not_committed` or\n`unknown`); `--all` and `--clean` list none.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeptLease"
          }
        },
        "failed": {
          "description": "Leases whose release failed, read back from the store afterwards:\n`why: failed` ones are still held (as each record shows), and\n`why: uncertain` ones may be held or may have ended (the store\ncouldn't be read back; the record is as it was before the run).\nRunning the same command again retries them. A failed release the\nstore shows ended is listed in `released`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeptLease"
          }
        }
      },
      "required": [
        "released",
        "skipped",
        "failed"
      ]
    },
    "KeptLease": {
      "type": "object",
      "properties": {
        "lease": {
          "$ref": "#/$defs/LeaseRecord"
        },
        "why": {
          "$ref": "#/$defs/KeptWhy"
        },
        "reason": {
          "description": "The reason, for people.",
          "type": "string"
        }
      },
      "required": [
        "lease",
        "why",
        "reason"
      ]
    },
    "KeptWhy": {
      "oneOf": [
        {
          "description": "The release failed, and the store still holds the lease.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "The release failed and the store couldn't be read back: the lease\nmay still be held, or may have ended. Claim its path again before\nediting it.",
          "type": "string",
          "const": "uncertain"
        },
        {
          "description": "Its paths have uncommitted, staged or ignored changes in this\nworktree (or open work git can't see: hidden index entries,\nsubmodules).",
          "type": "string",
          "const": "uncommitted"
        },
        {
          "description": "No commit of yours in this worktree touched its paths since you\nclaimed it, claimed it again or renewed it.",
          "type": "string",
          "const": "not_committed"
        },
        {
          "description": "Git couldn't say whether its paths are clean or committed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/SeverityName"
        },
        "path": {
          "description": "Relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "node": {
          "description": "The node's id (`ws:id` outside the root workspace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "The actors it's about (a lease's holders): names other actors\nchose, so data, never part of the message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationOut"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
