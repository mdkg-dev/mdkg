{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.migrate.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.migrate.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/MigrateData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "MigrateData": {
      "type": "object",
      "properties": {
        "plan": {
          "description": "The plan's hash.",
          "type": "string"
        },
        "stage": {
          "description": "planned (dry run), or the migration's stage: done, rolled-back, or\nwhere it stopped.",
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph_id": {
          "type": "string"
        },
        "work_history": {
          "description": "Where the work history goes: `git` (it stays) or `store` (it\nbecomes log records and leaves git). The plan's hash covers it.",
          "type": "string"
        },
        "work_history_reason": {
          "description": "Why the work history goes there.",
          "type": "string"
        },
        "workspaces": {
          "description": "The workspaces the migration converts, each in place; the hash\ncovers them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanWorkspace"
          }
        },
        "against": {
          "description": "What the plan took from the migrated main it was made against.",
          "anyOf": [
            {
              "$ref": "#/$defs/Against"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "files": {
          "description": "Changes inside the graph.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "patch": {
          "description": "Changes outside it (applied only with --rewrite-refs).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanWarning"
          }
        },
        "plan_file": {
          "description": "The full plan, with every new file's content.",
          "type": [
            "string",
            "null"
          ]
        },
        "patch_file": {
          "description": "The --rewrite-refs patch, as a unified diff.",
          "type": [
            "string",
            "null"
          ]
        },
        "backups": {
          "anyOf": [
            {
              "$ref": "#/$defs/Backups"
            },
            {
              "type": "null"
            }
          ]
        },
        "restore": {
          "description": "With --restore-history: what comes back into git, and from where.",
          "anyOf": [
            {
              "$ref": "#/$defs/Restored"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "plan",
        "stage",
        "base",
        "graph_id",
        "work_history",
        "work_history_reason",
        "workspaces",
        "counts",
        "files",
        "patch",
        "warnings"
      ]
    },
    "PlanWorkspace": {
      "description": "A workspace the migration converts: its config entry stays as it is.",
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "folder": {
          "description": "Its folder, relative to the repository's top (`aux/.mdkg/`).",
          "type": "string"
        },
        "nodes": {
          "description": "How many of its nodes the plan converts.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "alias",
        "folder",
        "nodes"
      ]
    },
    "Against": {
      "description": "What a plan made against a migrated main took from it (part of the\nplan, so of its hash).",
      "type": "object",
      "properties": {
        "ref": {
          "description": "The ref the plan was made against (`refs/heads/main`).",
          "type": "string"
        },
        "tip": {
          "description": "Its commit, and the commit that migrated it.",
          "type": "string"
        },
        "migration": {
          "type": "string"
        },
        "fork": {
          "description": "Where this branch forked from it.",
          "type": "string"
        },
        "adopted": {
          "description": "Graph files the branch hasn't changed since the fork, taken as\nmain has them.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "added": {
          "description": "Nodes main made after the fork, added as main has them.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "shared": {
          "description": "Nodes the branch changed that main has too (the same legacy id at\nthe fork), given main's ids.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "work_history": {
          "description": "Where this branch's work history goes: where main's migration put\nit (a `--work-history` that says otherwise is refused).",
          "$ref": "#/$defs/History"
        },
        "explicit": {
          "description": "Whether `--against` named the ref.",
          "type": "boolean"
        },
        "replayed": {
          "description": "Records main's migration made that this plan imports again, for a\nstore that doesn't have them (0 when it does, or when main kept its\nhistory in git).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "ref",
        "tip",
        "migration",
        "fork",
        "adopted",
        "added",
        "shared",
        "work_history",
        "explicit",
        "replayed"
      ]
    },
    "History": {
      "description": "Where a graph's work history goes: checkpoints, finished tests, event\nlogs, and progress and review-ledger sections.",
      "oneOf": [
        {
          "description": "It stays in git, for a graph that commits its work (`work.location`\n\"git\", which a 0.6 config with neither storage key is): checkpoints\nand finished tests stay nodes with new ids, and sections and event\nlogs stay as they are. No log records are written.",
          "type": "string",
          "const": "git"
        },
        {
          "description": "It moves to the coordinator store's log, as 0.7.0 migrated, and\nleaves git. The default when a stored plan names neither, since\n0.7.0's plans didn't: a plan 0.7.0 stored in a migration's journal\nkeeps its hash when this build resumes it. A 0.7.0 dry run's hash\nthat no apply started doesn't apply here (the config change differs:\n`work.location` is said now); plan again.",
          "type": "string",
          "const": "store"
        }
      ]
    },
    "Counts": {
      "description": "How many of each.",
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Nodes that stay, with new ids.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "kept_in_git": {
          "description": "Of those, checkpoints and finished tests kept in git as nodes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "tier_c": {
          "description": "Of those, tier C nodes kept as plain nodes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "checkpoints": {
          "description": "Checkpoints that became log records.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "check_results": {
          "description": "Finished tests that became check results.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "records": {
          "description": "Every log record: those, plus legacy events and review records.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "legacy_events": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "review_records": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "files_written": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "files_deleted": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "patch_files": {
          "description": "Files outside the graph the patch changes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "nodes",
        "kept_in_git",
        "tier_c",
        "checkpoints",
        "check_results",
        "records",
        "legacy_events",
        "review_records",
        "files_written",
        "files_deleted",
        "patch_files"
      ]
    },
    "FileChange": {
      "description": "One file change.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Relative to the repository's top.",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "before": {
          "description": "sha256 of the file before (empty for a file the change makes) and\nafter.",
          "type": "string"
        },
        "after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "action",
        "before"
      ]
    },
    "Action": {
      "description": "What happens to a file.",
      "type": "string",
      "enum": [
        "write",
        "delete"
      ]
    },
    "PlanWarning": {
      "description": "Something a reviewer should look at.",
      "type": "object",
      "properties": {
        "code": {
          "description": "A `migrate.*` code.",
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Backups": {
      "description": "The backups an apply takes.",
      "type": "object",
      "properties": {
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "store_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph_copy": {
          "type": "string"
        }
      },
      "required": [
        "graph_copy"
      ]
    },
    "Restored": {
      "description": "What a restore brings back, by kind.",
      "type": "object",
      "properties": {
        "migrations": {
          "description": "The migration commits the files come from, newest first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkpoints": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "check_results": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "event_logs": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "migrations",
        "checkpoints",
        "check_results",
        "event_logs"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/SeverityName"
        },
        "path": {
          "description": "Relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "node": {
          "description": "The node's id (`ws:id` outside the root workspace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "The actors it's about (a lease's holders): names other actors\nchose, so data, never part of the message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationOut"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
