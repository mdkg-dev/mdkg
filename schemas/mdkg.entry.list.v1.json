        "node.bad_priority",
        "node.priority_not_allowed",
        "node.bad_ref",
        "node.bad_skill_slug",
        "node.skills_not_allowed",
        "node.bad_scope",
        "node.supersedes_not_allowed",
        "node.bad_supersedes",
        "node.bad_identity",
        "node.identity_unsupported",
        "node.bad_integer",
        "node.duplicate_id",
        "node.bad_legacy_id",
        "node.duplicate_legacy_id",
        "node.extension_key_conflict",
        "node.stale_type",
        "node.date_only",
        "node.legacy_extension_key",
        "node.bad_body_link",
        "node.not_found",
        "node.ambiguous",
        "node.resolved",
        "node.exists",
        "node.none_ready",
        "node.not_work",
        "node.heading_missing",
        "node.raw_prompt",
