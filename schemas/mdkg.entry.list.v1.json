{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.entry.list.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.entry.list.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/ListData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "ListData": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntryRecord"
          }
        },
        "input_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions_in_force": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "node",
        "entries",
        "input_required",
        "decisions_in_force"
      ]
    },
    "EntryRecord": {
      "description": "One entry as `list` and `show` print it (A27, \"Fields\"): the names and\nvalues [`Entry::to_json`] gives, typed. Each context key is present\nonly when the entry holds it. A stored value that doesn't read back\nas its type here byte for byte stays in `other` as stored, so the\noutput never loses or changes one. Such a value prints under its own\nkey and doesn't fit that key's schema; no current writer stores one,\nand the sample-ledger test in tests/entry.rs fails on a new one.",
      "type": "object",
      "properties": {
        "node": {
          "description": "The node's id.",
          "type": "string"
        },
        "id": {
          "description": "`Q1`, `D2`, `F3`, `I4`, `V5`, `R6`: kind letter and number.",
          "type": "string"
        },
        "kind": {
          "description": "`question`, `decision`, `finding`, `issue`, `review` or `req`.",
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "opened": {
          "description": "Who opened it, when, and the message and turn it came in.",
          "$ref": "#/$defs/Stamp"
        },
        "anchor": {
          "description": "A finding's place.",
          "$ref": "#/$defs/EntryAnchor"
        },
        "requirement": {
          "description": "The requirement ids it is about.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asked_of": {
          "description": "The actor a question was asked of.",
          "type": "string"
        },
        "refs": {
          "description": "The entries it was opened from (`<node>#<id>`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "range": {
          "description": "A review round's range.",
          "$ref": "#/$defs/EntryRange"
        },
        "reviewers": {
          "description": "A review round's reviewers.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed": {
          "description": "The reviewers that completed a round, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Completion"
          }
        },
        "request": {
          "description": "The review request's message id that opened a round.",
          "type": "string"
        },
        "anchored": {
          "description": "The ref a round anchored on, or null for one that didn't.",
          "type": [
            "string",
            "null"
          ]
        },
        "answer": {
          "description": "A question's answer.",
          "$ref": "#/$defs/Answer"
        },
        "answered_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fix": {
          "description": "A finding's latest fix.",
          "$ref": "#/$defs/Fix"
        },
        "fix_commits": {
          "description": "Every fix commit declared, across reopens.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixers": {
          "description": "Every actor that recorded a fix.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_commits": {
          "description": "Fix commits a later fix superseded.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "description": "A verified finding's or a met requirement's verification.",
          "$ref": "#/$defs/Verified"
        },
        "duplicate_of": {
          "description": "A duplicate finding's original (`<node>#<id>`).",
          "type": "string"
        },
        "superseded_by": {
          "description": "The decision that superseded this one (`<node>#<id>`).",
          "type": "string"
        },
        "supersedes": {
          "description": "A proposed decision's ids that it supersedes once accepted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "moved_to": {
          "description": "A moved entry's copy (`<node>#<id>`).",
          "type": "string"
        },
        "waives": {
          "description": "A residual's waiver of a verified finding.",
          "$ref": "#/$defs/Waives"
        },
        "graph_folder": {
          "description": "A requirement's graph folder.",
          "type": "string"
        },
        "notified": {
          "description": "Reserved in the ledger's records; no op writes it yet."
        },
        "opened_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updated_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "node",
        "id",
        "kind",
        "state",
        "severity",
        "slot",
        "blocking",
        "title",
        "text",
        "opened_ms",
        "updated_ms"
      ],
      "additionalProperties": true
    },
    "Stamp": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "by",
        "at",
        "message",
        "turn"
      ]
    },
    "EntryAnchor": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "line"
      ]
    },
    "EntryRange": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        }
      },
      "required": [
        "base",
        "sha"
      ]
    },
    "Completion": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "verdict": {
          "description": "`clean` or `findings`.",
          "type": "string"
        },
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "reviewer",
        "by",
        "verdict",
        "at"
      ]
    },
    "Answer": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "at",
        "message",
        "text"
      ]
    },
    "Fix": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "sha",
        "commits",
        "by",
        "at"
      ]
    },
    "Verified": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "review": {
          "description": "A finding's: the round it was verified in.",
          "type": "string"
        },
        "fix_commits": {
          "description": "A finding's: the fix commits the verify covered.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fix_paths": {
          "description": "A finding's: the paths they changed.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sha",
        "by",
        "at"
      ]
    },
    "Waives": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "verified": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        }
      },
      "required": [
        "entry",
        "verified",
        "head",
        "base"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/SeverityName"
        },
        "path": {
          "description": "Relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "node": {
          "description": "The node's id (`ws:id` outside the root workspace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "The actors it's about (a lease's holders): names other actors\nchose, so data, never part of the message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationOut"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
    "Code": {
      "description": "A stable diagnostic code.",
      "type": "string",
      "enum": [
        "usage.invalid_arguments",
        "api.bad_cursor",
        "api.cursor_reset",
        "api.cursor_foreign",
        "api.cursor_expired",
        "usage.empty_query",
        "usage.bad_limit",
        "usage.unsupported_type",
        "usage.unknown_field",
        "usage.unknown_status",
