{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.affected.v1",
  "description": "Every command's JSON output.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "`mdkg.<command>.v<major>`.",
      "const": "mdkg.affected.v1"
    },
    "ok": {
      "description": "False exactly when there is an error diagnostic; the exit code is\nnon-zero exactly when this is false.",
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/AffectedData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "AffectedData": {
      "description": "The selection, or the reasons it fell back to a full run.",
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/Rev"
        },
        "head": {
          "$ref": "#/$defs/Rev"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "reasons": {
          "description": "Why the run is full; empty when it is selective. Sorted.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          }
        },
        "selected": {
          "description": "What a selective run needs; empty when the run is full.",
          "$ref": "#/$defs/Selected"
        },
        "paths": {
          "description": "Every changed path the selection judged and what it maps to,\nsorted by path. Paths in `from_main` aren't here.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathOut"
          }
        },
        "main": {
          "description": "The main branch `from_main` compares against; absent when no main\nref resolved and none was given.",
          "anyOf": [
            {
              "$ref": "#/$defs/MainOut"
            },
            {
              "type": "null"
            }
          ]
        },
        "from_main": {
          "description": "Changed paths whose content at the head equals main's at their merge\nbase: they came from main unchanged, so the selection skips them.\nSorted by path. Always present in this build's output; optional in\nthe schema, for older output.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FromMain"
          }
        },
        "warnings": {
          "description": "Selection notes for a selective run: paths using whole-crate\nfallback because no finer Rust rule covers them, and rule targets\nthe head doesn't have, which were skipped.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectionWarning"
          }
        },
        "snapshot": {
          "description": "Where the head's snapshot for the language adapters went, and the\nplaces passed over on the way; absent when no adapter needed one.",
          "anyOf": [
            {
              "$ref": "#/$defs/SnapshotOut"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "base",
        "head",
        "mode",
        "reasons",
        "selected",
        "paths"
      ]
    },
    "Rev": {
      "description": "A revision as given, and the commit it names.",
      "type": "object",
      "properties": {
        "rev": {
          "type": "string"
        },
        "sha": {
          "description": "The commit SHA; absent when `rev` names no commit, or when nothing\nwas resolved (a partial clone).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rev"
      ]
    },
    "Mode": {
      "description": "`selective`: run only `selected`. `full`: run everything.",
      "type": "string",
      "enum": [
        "selective",
        "full"
      ]
    },
    "Reason": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "path": {
          "description": "The changed path it concerns, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ]
    },
    "ReasonCode": {
      "description": "Why a run falls back to full: `base_missing`, `head_missing`,\n`base_not_ancestor` (or git can't tell), `partial_clone`,\n`unreadable_path`, `global_file`, `unmatched_path`, `rule_selects_all`,\n`adapter_failed`, `package_removed`, `config_invalid`.",
      "type": "string",
      "enum": [
        "base_missing",
        "head_missing",
        "base_not_ancestor",
        "partial_clone",
        "unreadable_path",
        "global_file",
        "unmatched_path",
        "rule_selects_all",
        "adapter_failed",
        "package_removed",
        "config_invalid"
      ]
    },
    "Selected": {
      "description": "What a selective run needs. Each list is sorted and has no duplicates.",
      "type": "object",
      "properties": {
        "go": {
          "description": "Go packages, per module.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GoSelection"
          }
        },
        "rust": {
          "description": "Rust workspace crates.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rust_targets": {
          "description": "Complete Rust execution plan. Prefer this over `rust` when present.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RustTestSelection"
          }
        },
        "suites": {
          "description": "Suites named by config rules; the consumer decides what they run.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "go",
        "rust",
        "suites"
      ]
    },
    "GoSelection": {
      "type": "object",
      "properties": {
        "module": {
          "description": "The module path from `go.mod`.",
          "type": "string"
        },
        "dir": {
          "description": "The module's folder, relative to the repository (`.` for the top).",
          "type": "string"
        },
        "packages": {
          "description": "Import paths.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "module",
        "dir",
        "packages"
      ]
    },
    "RustTestSelection": {
      "description": "One selected target and the combined Cargo invocation covering it.",
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "kind": {
          "description": "`package`, `lib`, `bin` or `test`.",
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "cargo_args": {
          "description": "Entries share grouped invocations: deduplicate before executing the plan.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "package",
        "kind",
        "cargo_args"
      ]
    },
    "PathOut": {
      "description": "One changed path.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "description": "git's status letter: `A`, `C`, `D`, `M`, `R` or `T`; any other\nletter comes with the `unreadable_path` reason.",
          "type": "string"
        },
        "old_path": {
          "description": "For a rename or copy, the path at the base. It is changed too.",
          "type": [
            "string",
            "null"
          ]
        },
        "matched_by": {
          "description": "What accounted for the path; empty when nothing did.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MatchKind"
          }
        },
        "selects": {
          "description": "What it selects (packages, crates, suites), sorted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "description": "Why it forces a full run, if it does.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "status",
        "matched_by",
        "selects"
      ]
    },
    "MatchKind": {
      "description": "What accounted for a changed path: `go` or `rust` (an adapter mapped\nit), `rule` (a config rule matched it), `global` (a global file).",
      "type": "string",
      "enum": [
        "go",
        "rust",
        "rule",
        "global"
      ]
    },
    "MainOut": {
      "description": "The main ref, and why nothing was skipped when that's so.",
      "type": "object",
      "properties": {
        "rev": {
          "description": "The ref as given (`--main`) or found (`mdkg.mainRef`, `main`).",
          "type": "string"
        },
        "sha": {
          "description": "The commit it names; absent when it names none.",
          "type": [
            "string",
            "null"
          ]
        },
        "merge_bases": {
          "description": "The head's merge bases with it, sorted; empty when none was used.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "description": "Why no path was compared (for example, the head is on main).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rev",
        "merge_bases"
      ]
    },
    "FromMain": {
      "description": "A changed path that came from main unchanged.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "description": "git's status letter between the base and the head.",
          "type": "string"
        },
        "old_path": {
          "description": "For a rename or copy, the path at the base; it matches main too.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "status"
      ]
    },
    "SelectionWarning": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "packages",
        "detail"
      ]
    },
    "SnapshotOut": {
      "description": "Where the head's snapshot went (`tree::places`, in order).",
      "type": "object",
      "properties": {
        "place": {
          "description": "The place used; `null` when the snapshot wasn't written, and the run\nis full with an `adapter_failed` reason: `error` says why.",
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "description": "The places tried before it (or all of them), each with why. Empty\nwith `place` null when the head's tree was refused before any place\nwas tried (a symlink in it, say).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Skipped"
          }
        },
        "error": {
          "description": "Why the snapshot wasn't written; absent when it was.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "place",
        "skipped"
      ]
    },
    "Place": {
      "description": "Where a snapshot can go, in the order tried.",
      "oneOf": [
        {
          "description": "The system temporary folder (`$TMPDIR`).",
          "type": "string",
          "const": "temp"
        },
        {
          "description": "The user's cache: `$XDG_CACHE_HOME/mdkg/affected`, else\n`~/Library/Caches/mdkg/affected` on macOS and\n`~/.cache/mdkg/affected` elsewhere.",
          "type": "string",
          "const": "user_cache"
        },
        {
          "description": "`$CARGO_TARGET_DIR/mdkg-affected`: the build folder a sandbox\ngrants a reviewer that runs tests.",
          "type": "string",
          "const": "cargo_target_dir"
        }
      ]
    },
    "Skipped": {
      "description": "A place a snapshot didn't go, and why.",
      "type": "object",
      "properties": {
        "place": {
          "$ref": "#/$defs/Place"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "place",
        "detail"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/SeverityName"
        },
        "path": {
          "description": "Relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "node": {
          "description": "The node's id (`ws:id` outside the root workspace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "description": "The actors it's about (a lease's holders): names other actors\nchose, so data, never part of the message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationOut"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
