{
  "$comment": "The normative node schema of mdkg format 0.7 (docs/format-0.7.md, section 3.5). Changing it is a format change: a new format_version.",
  "format_version": "0.7",
  "kinds": {
    "scalar": "a string value",
    "list": "a [a, b] list",
    "boolean": "true or false"
  },
  "constraints": {
    "node-id": "<type>-<uuid> (section 4)",
    "type": "one of the types below",
    "non-empty": "not empty after trimming",
    "status": "work types: the config's statuses (a goal also takes archived); dec: proposed, accepted, rejected, superseded; other types: not allowed",
    "integer": "-?[0-9]+, within the config's priority range; work types only",
    "timestamp": "YYYY-MM-DDTHH:MM:SS.mmmZ, or YYYY-MM-DD (warned)",
    "lowercase": "every item lowercase",
    "text": "any string; the format doesn't interpret it (section 5: other *_refs keys of loops and agent workflow types)",
    "ref-or-uri": "a node ref (section 5) or a URI whose scheme isn't mdkg",
    "skill-slug": "kebab-case, [a-z0-9]+(-[a-z0-9]+)*; skills only on work types",
    "dec-id": "a node id of type dec",
    "goal-state": "active, paused, achieved, blocked, budget_limited or archived",
    "goal-condition": "not empty, at most 4000 UTF-16 code units",
    "unpinned-ref": "a node id or graph ref, with no pin",
    "positive-integer": "[1-9][0-9]*",
    "legacy-id": "a lowercase mdkg 0.6.0 canonical or portable id"
  },
  "common_keys": {
    "legacy_id": {
      "kind": "scalar",
      "constraint": "legacy-id"
    }
  },
  "extension_keys": "x-<namespace>.<field>[.<field>...] (section 8), and legacy x_<anything>, on every type; never in this schema",
