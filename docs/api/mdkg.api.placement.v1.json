{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.api.placement.v1",
  "description": "Draft (mdkg API v1; see docs/api.md). May change until the release that first emits it. Where an agent's turns run (A8).",
  "x-mdkg-status": "draft",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mdkg.api.placement.v1"
    },
    "ok": {
      "type": "boolean",
      "description": "False exactly when there is an error diagnostic."
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/Placement"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "Placement": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "The resource's path at its coordinator, beginning `/v1/`."
        },
        "agent": {
          "type": "string",
          "description": "The resource's path at its coordinator, beginning `/v1/`."
        },
        "machine": {
          "type": "string",
          "description": "The resource's path at its coordinator, beginning `/v1/`."
        },
        "checkout": {
          "type": [
            "string",
            "null"
          ],
          "description": "A resource path, or null."
        },
        "source": {
          "type": "string",
          "description": "Where the placement came from. An open set: accept values not listed.",
          "x-mdkg-open": true,
          "examples": [
            "local",
            "assigned"
          ]
        }
      },
      "required": [
        "uri",
        "agent",
        "machine",
        "source"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "A stable diagnostic code."
        },
        "severity": {
          "type": "string",
          "description": "Severity.",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "A diagnostic, as every command's envelope writes it."
    }
  }
}
