{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.api.turn_output.v1",
  "description": "Draft (mdkg API v1; see docs/api.md). May change until the release that first emits it. One event of a turn's live output, normalized across harnesses: one NDJSON line from `agents logs --follow --json`.",
  "x-mdkg-status": "draft",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mdkg.api.turn_output.v1"
    },
    "turn": {
      "type": [
        "string",
        "null"
      ],
      "description": "The turn's path. Null only for `agent.state`, which belongs to the agent."
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "From 1 within the turn, assigned once when the launcher writes the event, so every reader sees the same seq. Filtered views have gaps. Null only for `agent.state`, which is ephemeral and never a position."
    },
    "position": {
      "type": "string",
      "description": "Opaque: where this event is in the agent's output. Pass it to `agents logs --after` as it is, to resume with the event after this one; a synthesized `turn.ended`'s resumes with the next turn. Absent on `agent.state`, on the `turn.started` sent for a purged turn, and from builds before 0.7.2."
    },
    "time": {
      "type": "string",
      "description": "RFC 3339 UTC to the millisecond."
    },
    "type": {
      "type": "string",
      "description": "The event type. An open set: accept values not listed.",
      "x-mdkg-open": true,
      "examples": [
        "turn.started",
        "text",
        "tool.started",
        "tool.ended",
        "usage",
        "status",
        "error",
        "harness.starting",
        "turn.ended",
        "agent.state",
        "native"
      ]
    },
    "data": {
      "type": "object",
      "description": "The type's payload, selected by `type` below: text, status, error: TextData. tool.started: ToolStartedData. tool.ended: ToolEndedData. usage: UsageData. turn.started: TurnStartedData. turn.ended: TurnEndedData. harness.starting: HarnessStartingData, just before spawn. agent.state: AgentStateData (agent follow only). native: NativeData. A type not listed carries an object. Text is the agent's output: untrusted data."
    }
  },
  "required": [
    "schema",
    "turn",
    "seq",
    "time",
    "type",
    "data"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "text",
              "status",
              "error"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/TextData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "tool.started"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/ToolStartedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "tool.ended"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/ToolEndedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "usage"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/UsageData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "turn.started"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/TurnStartedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "turn.ended"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/TurnEndedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "harness.starting"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/HarnessStartingData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "agent.state"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/AgentStateData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "native"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/NativeData"
          }
        }
      }
    }
  ],
  "$defs": {
    "ToolClass": {
      "type": "string",
      "description": "The hook format's tool classes. An open set: accept values not listed.",
      "x-mdkg-open": true,
      "examples": [
        "edit",
        "shell",
        "read",
        "mcp",
        "other"
      ]
    },
    "TextData": {
      "type": "object",
      "description": "text, status and error: one piece of the agent's or harness's output, cut to the launcher's limit.",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "ToolStartedData": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/ToolClass"
        },
        "name": {
          "type": "string",
          "description": "The harness's tool name; empty when it gave none."
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The harness's own id for this tool call: Claude's tool_use id; OpenCode's callID, or its tool part's id when it gives no callID. Within one turn, a tool.started and the tool.ended with the same non-null call_id are one call, even when calls with the same name overlap. Null when the harness gave neither, and absent from output written before 0.7.2: the pairing is then unknown."
        },
        "summary": {
          "type": "string",
          "description": "A short summary of the tool's input, such as its path; may be empty."
        }
      },
      "required": [
        "class",
        "name",
        "summary"
      ]
    },
    "ToolEndedData": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/ToolClass"
        },
        "name": {
          "type": "string"
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Within one turn, the call_id of the tool.started this ends; null when the harness gave none, and the pairing is then unknown. Null when the harness gave none; absent from output written before 0.7.2."
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "class",
        "name",
        "ok"
      ]
    },
    "UsageData": {
      "type": "object",
      "description": "The turn's usage so far. Null where the harness reports no such count.",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "The cost the harness reports, passed through as it is."
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "total_tokens",
        "cost_usd"
      ]
    },
    "TurnStartedData": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "description": "The turn's id (a UUID)."
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "description": "The agent's turn number."
        }
      },
      "required": [
        "turn_id",
        "number"
      ]
    },
    "TurnEndedData": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": [
            "string",
            "null"
          ],
          "description": "The turn's outcome, as its receipt records it, such as `replied`; `null` in a frame `agents logs` makes for an ended turn whose outcome it can't read (no receipt, and no outcome in its index or journal)."
        },
        "output_gone": {
          "const": true,
          "description": "Present only when the turn's journal is gone and a follow shows the turn from its index line."
        }
      },
      "required": [
        "outcome"
      ]
    },
    "HarnessStartingData": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "description": "An open set: accept values not listed.",
          "x-mdkg-open": true,
          "examples": [
            "claude",
            "codex",
            "opencode"
          ]
        }
      },
      "required": [
        "harness"
      ]
    },
    "AgentStateData": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "description": "The agent's state, as `agents status` gives it. An open set: accept values not listed.",
          "x-mdkg-open": true
        }
      },
      "required": [
        "state"
      ]
    },
    "NativeData": {
      "type": "object",
      "description": "A harness event the launcher doesn't normalize, passed through as the harness printed it: untrusted data.",
      "properties": {
        "harness": {
          "type": "string",
          "x-mdkg-open": true,
          "examples": [
            "claude",
            "codex",
            "opencode"
          ]
        },
        "event": {
          "description": "The harness's own JSON."
        }
      },
      "required": [
        "harness",
        "event"
      ]
    }
  }
}
