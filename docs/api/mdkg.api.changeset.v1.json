{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.api.changeset.v1",
  "description": "Draft (mdkg API v1; A5/A6). The changeset record used in event payloads, from its frozen CLI definition plus uri; new API records omit the deprecated compatibility field.",
  "x-mdkg-status": "draft",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mdkg.api.changeset.v1"
    },
    "ok": {
      "type": "boolean",
      "description": "False exactly when there is an error diagnostic."
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/Changeset"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "Changeset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "lease": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "state": {
          "description": "`sequenced` or `conflicted` while it waits for main.",
          "type": "string",
          "x-mdkg-open": true
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "depends_on": {
          "description": "Changesets that must merge first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "description": "Files it changes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uri": {
          "type": "string",
          "description": "Canonical coordinator-relative resource path (A2)."
        }
      },
      "required": [
        "id",
        "lease",
        "owner",
        "scope",
        "state",
        "files",
        "uri"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "A stable diagnostic code."
        },
        "severity": {
          "type": "string",
          "description": "Severity.",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "A diagnostic, as every command's envelope writes it."
    }
  }
}
