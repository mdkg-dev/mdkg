{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.api.coordinator.v1",
  "description": "Draft (mdkg API v1; see docs/api.md). May change until the release that first emits it. The coordinator, the root resource (A3).",
  "x-mdkg-status": "draft",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mdkg.api.coordinator.v1"
    },
    "ok": {
      "type": "boolean",
      "description": "False exactly when there is an error diagnostic."
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coordinator"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "Coordinator": {
      "type": "object",
      "properties": {
        "uri": {
          "const": "/v1"
        },
        "id": {
          "type": "string",
          "description": "The store's `store_id`; a restored copy keeps it."
        },
        "api": {
          "const": "v1"
        },
        "build": {
          "type": "object",
          "description": "As `version --json` reports it."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "A capability (A17). An open set: accept values not listed.",
            "x-mdkg-open": true,
            "examples": [
              "api.v1",
              "events",
              "events.agents",
              "msg.watch",
              "turn.output",
              "agents.status.reattach",
              "agents.stop.drain",
              "run.wrapper",
              "channels",
              "serve",
              "serve.tcp",
              "machines.enroll",
              "api.check"
            ]
          }
        },
        "store": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "mail_schema": {
              "type": "string"
            },
            "restore_generation": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "schema",
            "mail_schema",
            "restore_generation"
          ]
        },
        "graphs": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "The resource's path at its coordinator, beginning `/v1/`."
          }
        },
        "event_cursor": {
          "type": "string",
          "description": "An opaque event stream cursor (A10). Store it and give it back; never parse it."
        }
      },
      "required": [
        "uri",
        "id",
        "api",
        "capabilities",
        "store",
        "graphs",
        "event_cursor"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "A stable diagnostic code."
        },
        "severity": {
          "type": "string",
          "description": "Severity.",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "A diagnostic, as every command's envelope writes it."
    }
  }
}
