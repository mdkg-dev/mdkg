{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.agents.stop.v1",
  "description": "Draft (mdkg API v1; see docs/api.md). May change until the release that first emits it. `agents stop --drain --json` (A18).",
  "x-mdkg-status": "draft",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mdkg.agents.stop.v1"
    },
    "ok": {
      "type": "boolean",
      "description": "False exactly when there is an error diagnostic."
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/StopData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "StopData": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "supervisor_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": "string",
                "description": "The agent's stop state. An open set: accept values not listed.",
                "x-mdkg-open": true,
                "examples": [
                  "draining",
                  "stopped",
                  "not_running"
                ]
              },
              "in_flight_turn": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The turn still running, if any."
              }
            },
            "required": [
              "name",
              "supervisor_id",
              "state",
              "in_flight_turn"
            ]
          }
        }
      },
      "required": [
        "agents"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "A stable diagnostic code."
        },
        "severity": {
          "type": "string",
          "description": "Severity.",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "A diagnostic, as every command's envelope writes it."
    }
  }
}
