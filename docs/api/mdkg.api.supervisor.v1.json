{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdkg.api.supervisor.v1",
  "description": "Draft (mdkg API v1; see docs/api.md). May change until the release that first emits it. One `agents up` process (A7).",
  "x-mdkg-status": "draft",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mdkg.api.supervisor.v1"
    },
    "ok": {
      "type": "boolean",
      "description": "False exactly when there is an error diagnostic."
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/Supervisor"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticOut"
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "diagnostics"
  ],
  "$defs": {
    "Supervisor": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "The resource's path at its coordinator, beginning `/v1/`."
        },
        "supervisor_id": {
          "type": "string",
          "description": "UUIDv7, minted at start (0.7.1)."
        },
        "machine": {
          "type": "string",
          "description": "The resource's path at its coordinator, beginning `/v1/`."
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "build": {
          "type": "object"
        },
        "started_at": {
          "type": "string",
          "description": "RFC 3339 UTC to the millisecond."
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "The resource's path at its coordinator, beginning `/v1/`."
          }
        },
        "state": {
          "type": "string",
          "description": "`stale`: its process is gone. An open set: accept values not listed.",
          "x-mdkg-open": true,
          "examples": [
            "running",
            "draining",
            "stopped",
            "stale"
          ]
        },
        "heartbeat_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC 3339 UTC to the millisecond, or null."
        },
        "progress": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "description": "The resource's path at its coordinator, beginning `/v1/`."
              },
              "watch_id": {
                "type": "string"
              },
              "ran": {
                "type": "integer",
                "minimum": 0
              },
              "seen": {
                "type": "integer",
                "minimum": 0
              },
              "needs_recovery": {
                "type": "boolean"
              }
            },
            "required": [
              "agent",
              "needs_recovery"
            ]
          }
        }
      },
      "required": [
        "uri",
        "supervisor_id",
        "machine",
        "pid",
        "started_at",
        "agents",
        "state"
      ]
    },
    "DiagnosticOut": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "A stable diagnostic code."
        },
        "severity": {
          "type": "string",
          "description": "Severity.",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "description": "A diagnostic, as every command's envelope writes it."
    }
  }
}
