    "graph_id": "01a18fd1-7b2b-70b1-8d2f-f4ece2360596",
    "files": {
      "work.txt": "initial content\n"
    }
  },
  "operations": [
    {
      "op": "node.list",
      "actor": "a",
      "args": {},
      "expect": {
        "schema": "mdkg.list.v1",
        "ok": true
      },
      "outcomes": {
        "cli-local": 0,
        "mcp": false,
        "http-socket": 200
      }
    },
    {
      "op": "node.show",
      "actor": "a",
      "args": {
        "id": "task-nope"
      },
      "expect": {
        "schema": "mdkg.show.v1",
        "ok": false,
