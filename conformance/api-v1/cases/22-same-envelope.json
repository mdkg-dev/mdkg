        "cli-local": 0,
        "mcp": false,
        "http-socket": 200
      },
      "per_copy": [
        "/data/event_cursor"
      ]
    },
    {
      "op": "lease.release",
      "actor": "a",
      "args": {
        "target": "work.txt"
      },
      "expect": {
        "schema": "mdkg.release.v1",
